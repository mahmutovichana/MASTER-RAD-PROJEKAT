# Lokalno ostavite prazno: Webpack proxy šalje /api na backend port 5002.
API_BASE_URL=

# Keycloak se uključuje isključivo eksplicitno. Bez ovoga aplikacija koristi
# lokalnog razvojnog korisnika i ne radi nikakav redirect.
KEYCLOAK_ENABLED=false
KEYCLOAK_URL=
KEYCLOAK_REALM=rbbh
KEYCLOAK_CLIENT_ID=collateral-appraisal-web

# Localization bundles are served by the React application itself by default.
# LOCALIZATION_MANIFEST_URL=/localization/manifests/latest.json
