# Lokalni Development radi i sa svim praznim vrijednostima.
ASPNETCORE_ENVIRONMENT=Development

# Jedini podržani način konfiguracije SQL Servera. Ako su ServerName i Name
# prazni, Development koristi seedovanu InMemory bazu.
# Windows/SSMS primjer:
# Database__ServerName=localhost\SQLEXPRESS
# Database__Name=PropertyValuation_Local
# Database__IntegratedSecurity=true
Database__ServerName=
Database__Name=
Database__IntegratedSecurity=false
Database__User=
Database__Password=

# Prazno/false koristi lokalni Development administrator.
Keycloak__Enabled=false
Keycloak__Authority=
Keycloak__Audience=
KeycloakAdmin__ClientId=
KeycloakAdmin__ClientSecret=

# React preskače OIDC kada bilo koja vrijednost nedostaje.
API_BASE_URL=http://127.0.0.1:5002
KEYCLOAK_ENABLED=false
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
