@using Microsoft.AspNetCore.Components.Web

<MudPaper Class="rbi-paper" Elevation="2" Style="text-align:center; padding: 2rem;">
    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline"
             Size="Size.Large"
             Color="Color.Error"
             Class="mb-3" />
    <MudText Typo="Typo.h6" Class="mb-2">Došlo je do neočekivane greške</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
        Pokušajte osvježiti stranicu. Ako se problem ponavlja, kontaktirajte administratora.
    </MudText>
    <MudButton Variant="Variant.Outlined"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Refresh"
               OnClick="@(() => Recovery?.Invoke())">
        Pokušaj ponovo
    </MudButton>
</MudPaper>

@code {
    [Parameter] public Action? Recovery { get; set; }
}
