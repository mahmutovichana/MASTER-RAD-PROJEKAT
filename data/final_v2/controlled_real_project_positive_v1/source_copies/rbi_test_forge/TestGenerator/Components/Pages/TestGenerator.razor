        _projectError      = null;
        _projectFileNames  = [];
    }

    /// <summary>
    /// Učitava cijeli Blazor projekat: prihvata <c>.zip</c> (raspakuje .razor/.razor.cs entryje)
    /// ili direktno odabrane <c>.razor</c> fajlove, te pokreće <see cref="BlazorProjectAnalyzer"/>.
    /// </summary>
    private async Task OnProjectFilesSelected(InputFileChangeEventArgs e)
    {
        _projectParsing    = true;
        _projectError      = null;
        _projectAnalysis   = null;
        _selectedComponent = null;
        _blazorResult      = null;
        _blazorSpec        = null;
        _projectFileNames  = [];

        try
        {
            var razorFiles = new List<BlazorRazorFile>();

            foreach (var file in e.GetMultipleFiles(MaxUploadFiles))
            {
                _projectFileNames.Add(file.Name);

                await using var stream = file.OpenReadStream(MaxUploadBytes);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                ms.Position = 0;

                if (file.Name.EndsWith(".zip", StringComparison.OrdinalIgnoreCase))
                {
                    using var zip = new System.IO.Compression.ZipArchive(ms, System.IO.Compression.ZipArchiveMode.Read);
                    foreach (var entry in zip.Entries)
                    {
                        if (entry.Length == 0) continue; // folder entry
                        // .razor + .razor.cs code-behind (analyzer spaja istoimene fajlove radi tačnije detekcije).
                        if (!entry.FullName.EndsWith(".razor", StringComparison.OrdinalIgnoreCase)
                         && !entry.FullName.EndsWith(".razor.cs", StringComparison.OrdinalIgnoreCase)) continue;

                        using var reader = new StreamReader(entry.Open());
                        razorFiles.Add(new BlazorRazorFile(entry.FullName, await reader.ReadToEndAsync()));
                    }
                }
                else // pojedinačni .razor / .razor.cs fajl
                {
                    using var reader = new StreamReader(ms);
                    razorFiles.Add(new BlazorRazorFile(file.Name, await reader.ReadToEndAsync()));
                }
            }

            _projectAnalysis = BlazorProjectAnalyzer.Analyze(razorFiles);

            if (_projectAnalysis.Components.Count == 0)
                _projectError = _projectAnalysis.Warnings.FirstOrDefault()
                    ?? "U učitanom projektu nije pronađena nijedna komponenta.";
            else
                Toast.Success($"Učitano: {_projectAnalysis.PageCount} stranica, " +
                              $"{_projectAnalysis.ComponentCount} komponenti.");
        }
        catch (Exception ex)
        {
            _projectError = $"Učitavanje projekta nije uspjelo: {ex.Message}";
        }
        finally
        {
            _projectParsing = false;
        }
    }

