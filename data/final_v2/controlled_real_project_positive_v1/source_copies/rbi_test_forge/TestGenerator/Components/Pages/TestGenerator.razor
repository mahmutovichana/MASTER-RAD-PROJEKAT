    private async Task DownloadZip(GeneratedTestProject project, string zipName)
    {
        try
        {
            using var ms = new System.IO.MemoryStream();
            using (var zip = new System.IO.Compression.ZipArchive(ms, System.IO.Compression.ZipArchiveMode.Create, leaveOpen: true))
            {
                foreach (var file in project.Files)
                {
                    var entry = zip.CreateEntry(file.FileName);
                    await using var writer = new System.IO.StreamWriter(entry.Open());
                    await writer.WriteAsync(file.Content);
                }
            }
            var base64 = Convert.ToBase64String(ms.ToArray());
            await JS.InvokeVoidAsync("testforgeDownload", zipName, base64);
        }
        catch (Exception ex)
        {
            Toast.Error($"Greška pri preuzimanju: {ex.Message}");
        }
    }
