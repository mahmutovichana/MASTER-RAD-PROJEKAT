    private void HandleBlazorAnalyze()
    {
        if (string.IsNullOrWhiteSpace(_blazorRazorContent))
        {
            Toast.Error("Zalijepite sadržaj .razor fajla.");
            return;
        }

        var name = string.IsNullOrWhiteSpace(_blazorComponentName)
            ? "Komponenta"
            : _blazorComponentName.Trim();

        _blazorSpec   = BlazorComponentAnalyzer.Analyze(name, _blazorRazorContent);
