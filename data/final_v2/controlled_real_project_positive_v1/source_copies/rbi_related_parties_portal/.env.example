# Sve vrijednosti su opcionalne za lokalni Development start.
ASPNETCORE_ENVIRONMENT=Development

# Jedini podržani način konfiguracije SQL Servera. Ako su ServerName i Name
# prazni ili SQL nije dostupan preko trenutne mreže, lokalni Development koristi
# seedovanu InMemory bazu i ispisuje upozorenje.
# Windows/SSMS primjer:
# Database__ServerName=localhost\SQLEXPRESS
# Database__Name=RPR_Local
# Database__IntegratedSecurity=true
# OCP/SQL korisnik: IntegratedSecurity=false i User/Password dolaze iz Secreta.
Database__ServerName=
Database__Name=
Database__IntegratedSecurity=false
Database__User=
Database__Password=

# Keycloak API validacija. Prazno/false koristi lokalni Development identitet.
KeycloakSettings__Enabled=false
KeycloakSettings__Issuer=
KeycloakSettings__PublicIssuer=
KeycloakSettings__Audience=connected-parties-api
KeycloakSettings__AdminClientId=
KeycloakSettings__AdminClientSecret=

Cors__AllowedOrigins__0=http://127.0.0.1:8080

# React. Prazne Keycloak vrijednosti preskaču login redirect.
API_BASE_URL=http://127.0.0.1:5000
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
LOCALIZATION_MANIFEST_URL=/localization/manifests/development.json
APP_ENVIRONMENT=Development
