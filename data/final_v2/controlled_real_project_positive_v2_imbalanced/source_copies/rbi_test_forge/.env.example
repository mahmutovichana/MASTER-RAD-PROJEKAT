# Lokalni Development radi s praznom bazom i Keycloak konfiguracijom.
ASPNETCORE_ENVIRONMENT=Development
API_BASE_URL=http://127.0.0.1:5001

# Jedini podržani način konfiguracije SQL Servera. Ako su ServerName i Name
# prazni, Development koristi seedovanu InMemory bazu.
# Windows/SSMS primjer:
# Database__ServerName=localhost\SQLEXPRESS
# Database__Name=TestGenerator_Local
# Database__IntegratedSecurity=true
Database__ServerName=
Database__Name=
Database__IntegratedSecurity=false
Database__User=
Database__Password=

# Prazan Keycloak koristi lokalni Development identitet.
MockAuth__Enabled=false
OpenIDConnectSettings__Authority=
OpenIDConnectSettings__ClientId=
OpenIDConnectSettings__ClientSecret=
KeycloakAdmin__ClientId=
KeycloakAdmin__ClientSecret=
