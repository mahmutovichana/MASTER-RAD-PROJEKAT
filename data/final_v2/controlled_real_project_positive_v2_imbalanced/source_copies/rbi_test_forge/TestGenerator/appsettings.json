{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Warning",
        "Hangfire": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console"
        }
      }
    ],
    "Properties": {
      "Application": "RBBH.TestAutomation.Api"
    }
  },
  "OpenIDConnectSettings": {
    "Authority": "",
    "ClientId": "",
    "ClientSecret": ""
  },
  "KeycloakAdmin": {
    "ClientId": "",
    "ClientSecret": ""
  },
  "GitHubE2E": {
    "Owner": "rbbhofficial",
    "Repo": "rbbh-test-automation",
    "WorkflowFile": "e2e-scenario.yml",
    "Ref": "dev",
    "BaseUrl": "https://tag.rbbh-test-automation.local",
    "Token": ""
  },
  "Notifications": {
    "AppBaseUrl": "",
    "GlobalRecipients": [],
    "Email": {
      "Enabled": false,
      "SmtpHost": "",
      "SmtpPort": 587,
      "UseSsl": true,
      "Username": "",
      "Password": "",
      "FromAddress": "",
      "FromName": "RBBH Test Automation"
    }
  },
  "AllowedHosts": "*"
}
