<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NuGetAudit>false</NuGetAudit>

    <RootNamespace>RBBH.TestAutomation.Api</RootNamespace>
    <AssemblyName>TestGenerator</AssemblyName>
    <OutputType>Exe</OutputType>
    <DefaultItemExcludes>$(DefaultItemExcludes);**\bin\**;**\obj\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Content Include=".gitignore" />
    <RazorComponent Remove="Components\**\*.razor" />
    <Content Remove="Components\**\*.razor" />
    <Content Remove="Components\**\*.razor.css" />
    <None Remove="Components\**\*.razor.css" />
    <Compile Remove="Theme\**\*.cs" />
    <Compile Remove="Services\ToastService.cs" />
    <Compile Remove="Services\BaseApiService.cs" />
    <Compile Remove="Services\Result.cs" />
    <Compile Remove="Core\**\*.cs;E2ETests\**\*.cs;UnitTests\**\*.cs" />
    <Content Remove="Core\**;E2ETests\**;UnitTests\**" />
    <EmbeddedResource Remove="Core\**;E2ETests\**;UnitTests\**" />
    <None Remove="Core\**;E2ETests\**;UnitTests\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Core\RBBH.TestAutomation.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="8.0.8" />
	<PackageReference Include="Serilog.AspNetCore" Version="8.0.2" />
	<PackageReference Include="Serilog.Formatting.Elasticsearch" Version="10.0.0" />
	<PackageReference Include="Nanoid" Version="3.1.0" />
	<PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.1" />
	<PackageReference Include="Dapper" Version="2.1.66" />
	<PackageReference Include="YamlDotNet" Version="16.3.0" />
	<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.4">
	  <PrivateAssets>all</PrivateAssets>
	  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	</PackageReference>
	<PackageReference Include="Hangfire.AspNetCore" Version="1.8.17" />
	<PackageReference Include="Hangfire.SqlServer" Version="1.8.17" />
	<PackageReference Include="Hangfire.InMemory" Version="0.10.0" />
	<PackageReference Include="Hangfire.Console" Version="1.4.3" />
	<!-- Overrides Hangfire's old transitive version with the security-patched release. -->
	<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
	<PackageReference Include="Cronos" Version="0.8.4" />
	<PackageReference Include="Swashbuckle.AspNetCore" Version="6.7.3" />
  </ItemGroup>
</Project>
